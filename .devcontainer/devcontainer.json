{
  "name": "Forklift",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install -e '.[dev]' && npx -y @acala-network/chopsticks@1.5.2 --version && forklift --version",
  "forwardPorts": [9944],
  "portsAttributes": {
    "9944": { "label": "Forklift fork (WebSocket RPC)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/python/current/bin/python" }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
